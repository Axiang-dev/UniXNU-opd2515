+        start = text.find(variable)
+        if start < 0:
+            sys.exit(f'{rule}: {variable} not found')
+        end = text.find('\n', start)
+        if end < 0:
+            sys.exit(f'{rule}: {variable} has no terminating newline')
+        line = text[start:end]
+        record = ' -MJ $(@).json '
+        base = line.split(' -MJ ', 1)[0].rstrip()
+        replacement = base + record
+        if replacement != line:
+            text = text[:start] + replacement + text[end:]
+            changed = True
+    if changed:
