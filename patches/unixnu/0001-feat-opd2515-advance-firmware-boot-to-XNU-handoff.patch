+                    (VOID **)&Gop
+                    );
+  }
+
+  if (EFI_ERROR (Status)) {
+    Status = gBS->LocateProtocol (&gEfiGraphicsOutputProtocolGuid, NULL, (VOID **)&Gop);
+  }
+
+  if (EFI_ERROR (Status) || (Gop == NULL) || (Gop->Mode == NULL) ||
+      (Gop->Mode->Info == NULL) || (Gop->Blt == NULL)) {
+    return;
+  }
+
+  Width  = MIN ((UINTN)Gop->Mode->Info->HorizontalResolution, (UINTN)512);
+  Height = MIN ((UINTN)Gop->Mode->Info->VerticalResolution, (UINTN)512);
+  if ((Width == 0) || (Height == 0)) {
+    return;
+  }
+
+  Color.Red      = Red;
+  Color.Green    = Green;
+  Color.Blue     = Blue;
+  Color.Reserved = 0;
+  Status = Gop->Blt (Gop, &Color, EfiBltVideoFill, 0, 0, 0, 0, Width, Height, 0);
+  if (!EFI_ERROR (Status)) {
+    gBS->Stall (1000000);
+  }
+}
