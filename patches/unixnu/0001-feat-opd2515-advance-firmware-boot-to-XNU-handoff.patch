+{
+  EFI_GRAPHICS_OUTPUT_PROTOCOL   *Gop;
+  EFI_GRAPHICS_OUTPUT_BLT_PIXEL  Color;
+  EFI_STATUS                    Status;
+  UINTN                         Width;
