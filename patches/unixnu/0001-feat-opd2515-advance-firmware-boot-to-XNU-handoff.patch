diff --git a/package/UniXNUPkg/Library/UniXNULib/BootLog.c b/package/UniXNUPkg/Library/UniXNULib/BootLog.c
new file mode 100644
index 0000000..cd6219e
--- /dev/null
+++ b/package/UniXNUPkg/Library/UniXNULib/BootLog.c
@@ -0,0 +1,267 @@
+/** @file
+  Persistent diagnostic log in a reserved window at the end of userdata.
+
+  The UEFI application runs before XNU and has no serial console on this board,
+  so the only place a crash can leave evidence is storage. Following the
+  upstream "persistent logs" design, the last 4 MiB of the userdata partition
+  hold one 4 KiB header followed by the text of this boot. The reader is the
+  recovery image:
+
+    dd if=/dev/block/by-name/userdata of=/tmp/unixnu-log.bin bs=1M \
+       skip=$(( $(blockdev --getsize64 /dev/block/by-name/userdata)/1048576 - 4 )) count=4
+
+  Writes are always inside that window; nothing else is touched.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include "Internal.h"
+
+#include <Protocol/BlockIo.h>
+#include <Protocol/PartitionInfo.h>
+
+#define UNIXNU_LOG_MAGIC        "UNIXNULG"
+#define UNIXNU_LOG_VERSION      1
+#define UNIXNU_LOG_REGION_SIZE  (4 * 1024 * 1024)
+#define UNIXNU_LOG_HEADER_SIZE  4096
+#define UNIXNU_LOG_TEXT_CAP     (128 * 1024)
+
+#pragma pack (1)
+typedef struct {
+  CHAR8     Magic[8];
+  UINT32    Version;
+  UINT32    HeaderSize;
+  UINT32    TextCapacity;
+  UINT32    TextBytes;
+  UINT32    Sequence;
+  UINT32    Reserved;
+  UINT64    PartitionBytes;
+  UINT64    RegionOffset;
+} UNIXNU_LOG_HEADER;
+#pragma pack ()
+
+STATIC EFI_BLOCK_IO_PROTOCOL  *mLogBlockIo;
+STATIC EFI_LBA                mLogStartLba;
+STATIC CHAR8                  *mLogText;
+STATIC UINTN                  mLogUsed;
+STATIC UINT32                 mLogSequence;
+STATIC UINT64                 mLogPartitionBytes;
+STATIC UINT64                 mLogRegionOffset;
+STATIC CHAR16                 mLogStatus[64] = L"log: not installed";
+
+//
+// Lines logged before the partition is found, kept so the start of the boot
+// survives even though storage is enumerated later.
+//
+#define UNIXNU_LOG_PRE_SIZE  4096
+STATIC CHAR8  mLogPre[UNIXNU_LOG_PRE_SIZE];
+STATIC UINTN  mLogPreUsed;
+
+VOID
+UniXNUAppendBootLog (
+  IN CONST CHAR8  *Text,
+  IN UINTN        Length
+  )
+{
+  UINTN  Drop;
+
+  if ((Text == NULL) || (Length == 0)) {
+    return;
+  }
+
+  if (mLogText == NULL) {
+    if (Length > UNIXNU_LOG_PRE_SIZE) {
+      Text  += Length - UNIXNU_LOG_PRE_SIZE;
+      Length = UNIXNU_LOG_PRE_SIZE;
+    }
+
+    if ((mLogPreUsed + Length) > UNIXNU_LOG_PRE_SIZE) {
+      Drop = mLogPreUsed + Length - UNIXNU_LOG_PRE_SIZE;
+      CopyMem (mLogPre, mLogPre + Drop, mLogPreUsed - Drop);
+      mLogPreUsed -= Drop;
+    }
+
+    CopyMem (mLogPre + mLogPreUsed, Text, Length);
+    mLogPreUsed += Length;
+    return;
+  }
+
+  if (Length > UNIXNU_LOG_TEXT_CAP) {
+    Text  += Length - UNIXNU_LOG_TEXT_CAP;
+    Length = UNIXNU_LOG_TEXT_CAP;
+  }
+
+  if ((mLogUsed + Length) > UNIXNU_LOG_TEXT_CAP) {
+    Drop = (mLogUsed + Length - UNIXNU_LOG_TEXT_CAP + 1023) & ~(UINTN)1023;
+    if (Drop > mLogUsed) {
+      Drop = mLogUsed;
+    }
+
+    CopyMem (mLogText, mLogText + Drop, mLogUsed - Drop);
+    mLogUsed -= Drop;
+  }
+
+  CopyMem (mLogText + mLogUsed, Text, Length);
+  mLogUsed += Length;
+}
+
+VOID
+UniXNULogFlush (
+  VOID
+  )
+{
+  EFI_STATUS         Status;
+  UINTN              Total;
+  UINTN              Pages;
+  UINT8              *Buffer;
+  UNIXNU_LOG_HEADER  *Header;
+
+  if ((mLogBlockIo == NULL) || (mLogText == NULL)) {
+    return;
+  }
+
+  Total = UNIXNU_LOG_HEADER_SIZE + mLogUsed;
+  Pages = EFI_SIZE_TO_PAGES (Total);
+  if ((Pages * EFI_PAGE_SIZE) > UNIXNU_LOG_REGION_SIZE) {
+    return;
+  }
+
+  Buffer = AllocatePages (Pages);
+  if (Buffer == NULL) {
+    return;
+  }
+
+  ZeroMem (Buffer, Pages * EFI_PAGE_SIZE);
+  Header = (UNIXNU_LOG_HEADER *)Buffer;
+  CopyMem (Header->Magic, UNIXNU_LOG_MAGIC, 8);
+  Header->Version        = UNIXNU_LOG_VERSION;
+  Header->HeaderSize     = UNIXNU_LOG_HEADER_SIZE;
+  Header->TextCapacity   = UNIXNU_LOG_TEXT_CAP;
+  Header->TextBytes      = (UINT32)mLogUsed;
+  Header->Sequence       = mLogSequence;
+  Header->PartitionBytes = mLogPartitionBytes;
+  Header->RegionOffset   = mLogRegionOffset;
+  CopyMem (Buffer + UNIXNU_LOG_HEADER_SIZE, mLogText, mLogUsed);
+
+  Status = mLogBlockIo->WriteBlocks (
+                          mLogBlockIo,
+                          mLogBlockIo->Media->MediaId,
+                          mLogStartLba,
+                          Pages * EFI_PAGE_SIZE,
+                          Buffer
+                          );
+  FreePages (Buffer, Pages);
+  if (!EFI_ERROR (Status)) {
+    mLogSequence++;
+  } else {
+    UnicodeSPrint (mLogStatus, sizeof (mLogStatus), L"log: write failed %r", Status);
+  }
+}
+
+EFI_STATUS
+UniXNUInstallBootLog (
+  VOID
+  )
+{
+  EFI_STATUS                   Status;
+  EFI_HANDLE                   *Handles;
+  UINTN                        Count;
+  UINTN                        Index;
+  EFI_PARTITION_INFO_PROTOCOL  *Info;
+  EFI_BLOCK_IO_PROTOCOL        *BlockIo;
+  EFI_LBA                      Blocks;
+  UINT8                        *Probe;
+
+  if (mLogBlockIo != NULL) {
+    return EFI_ALREADY_STARTED;
+  }
+
+  Status = gBS->LocateHandleBuffer (
+                  ByProtocol,
+                  &gEfiPartitionInfoProtocolGuid,
+                  NULL,
+                  &Count,
+                  &Handles
+                  );
+  if (EFI_ERROR (Status)) {
+    UniXNULog ("boot log: no partition handles: %r", Status);
+    return Status;
+  }
+
+  Status = EFI_NOT_FOUND;
+  for (Index = 0; Index < Count; Index++) {
+    if (EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiPartitionInfoProtocolGuid, (VOID **)&Info))) {
+      continue;
+    }
+
+    if ((Info->Type != PARTITION_TYPE_GPT) ||
+        ((UniXNUStriCmp (Info->Info.Gpt.PartitionName, L"userdata") != 0) &&
+         (UniXNUStriCmp (Info->Info.Gpt.PartitionName, L"USERDATA") != 0))) {
+      continue;
+    }
+
+    if (EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiBlockIoProtocolGuid, (VOID **)&BlockIo))) {
+      continue;
+    }
+
+    if ((BlockIo->Media == NULL) || !BlockIo->Media->MediaPresent || BlockIo->Media->ReadOnly) {
+      UniXNULog ("boot log: userdata is not writable");
+      continue;
+    }
+
+    Blocks = UNIXNU_LOG_REGION_SIZE / BlockIo->Media->BlockSize;
+    if ((Blocks == 0) || ((BlockIo->Media->LastBlock + 1) <= Blocks)) {
+      continue;
+    }
+
+    mLogBlockIo        = BlockIo;
+    mLogStartLba       = BlockIo->Media->LastBlock + 1 - Blocks;
+    mLogPartitionBytes = (BlockIo->Media->LastBlock + 1) * BlockIo->Media->BlockSize;
+    mLogRegionOffset   = (UINT64)mLogStartLba * BlockIo->Media->BlockSize;
+    mLogText           = AllocateZeroPool (UNIXNU_LOG_TEXT_CAP);
+    if (mLogText == NULL) {
+      mLogBlockIo = NULL;
+      Status      = EFI_OUT_OF_RESOURCES;
+      break;
+    }
+
+    if (mLogPreUsed != 0) {
+      UniXNUAppendBootLog (mLogPre, mLogPreUsed);
+      mLogPreUsed = 0;
+    }
+
+    mLogSequence = 0;
+    Probe        = AllocatePages (1);
+    if (Probe != NULL) {
+      if (!EFI_ERROR (BlockIo->ReadBlocks (BlockIo, BlockIo->Media->MediaId, mLogStartLba, EFI_PAGE_SIZE, Probe)) &&
+          (CompareMem (Probe, UNIXNU_LOG_MAGIC, 8) == 0)) {
+        mLogSequence = ((UNIXNU_LOG_HEADER *)Probe)->Sequence;
+      }
+
+      FreePages (Probe, 1);
+    }
+
+    Status = EFI_SUCCESS;
+    break;
+  }
+
+  FreePool (Handles);
+  if (EFI_ERROR (Status)) {
+    UniXNULog ("boot log: no writable userdata partition (%u partitions)", (UINT32)Count);
+    UnicodeSPrint (mLogStatus, sizeof (mLogStatus), L"log: no writable userdata");
+    return Status;
+  }
+
+  UnicodeSPrint (mLogStatus, sizeof (mLogStatus), L"log: userdata @0x%lx", mLogRegionOffset);
+  UniXNULog ("boot log: userdata %u MiB, window at 0x%lx", (UINT32)(mLogPartitionBytes >> 20), mLogRegionOffset);
+  UniXNULogFlush ();
+  return EFI_SUCCESS;
+}
+
+CONST CHAR16 *
+UniXNUGetBootLogStatus (
+  VOID
+  )
+{
+  return mLogStatus;
+}
diff --git a/package/UniXNUPkg/Library/UniXNULib/BootRamDisk.c b/package/UniXNUPkg/Library/UniXNULib/BootRamDisk.c
new file mode 100644
index 0000000..14754ea
--- /dev/null
+++ b/package/UniXNUPkg/Library/UniXNULib/BootRamDisk.c
@@ -0,0 +1,471 @@
+/** @file
+  Publish an Android boot image ramdisk as a read-only UEFI block device.
+
+  The Android bootloader describes the ramdisk range in /chosen. A standalone
+  UniXNU application does not get Mu-Silicium's entry-argument HOB, so read the
+  same properties from the firmware device-tree configuration table and expose
+  the volume before CachedFileSystem discovery runs.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include "Internal.h"
+
+#include <Guid/Fdt.h>
+#include <Library/FdtLib.h>
+#include <Protocol/BlockIo.h>
+#include <Protocol/DevicePath.h>
+
+#define BOOT_RAMDISK_BLOCK_SIZE  512
+
+// OPD2515 S6 diagnostic profile: current 208 MiB payload boot image.
+// Recheck this minimum when changing the payload or EFI packaging.
+#define BOOT_SCAN_MIN_IMAGE_SIZE  218210304ULL
+#define BOOT_SCAN_MAX_BYTES       0x80000000ULL
+#define BOOT_SCAN_MAX_CANDIDATES  64
+
+#pragma pack (1)
+typedef struct {
+  VENDOR_DEVICE_PATH          Vendor;
+  EFI_DEVICE_PATH_PROTOCOL    End;
+} BOOT_RAMDISK_DEVICE_PATH;
+#pragma pack ()
+
+STATIC BOOT_RAMDISK_DEVICE_PATH  mBootRamDiskDevicePath = {
+  {
+    {
+      HARDWARE_DEVICE_PATH,
+      HW_VENDOR_DP,
+      { (UINT8)sizeof (VENDOR_DEVICE_PATH), (UINT8)(sizeof (VENDOR_DEVICE_PATH) >> 8) }
+    },
+    { 0xA9C6827C, 0x1BD8, 0x410C, { 0x88, 0x5A, 0xC4, 0x65, 0x00, 0xF7, 0xD8, 0x36 } }
+  },
+  {
+    END_DEVICE_PATH_TYPE,
+    END_ENTIRE_DEVICE_PATH_SUBTYPE,
+    { sizeof (EFI_DEVICE_PATH_PROTOCOL), 0 }
+  }
+};
+
+STATIC UINT8                    *mBootRamDiskBase;
+STATIC EFI_BLOCK_IO_MEDIA       mBootRamDiskMedia;
+STATIC EFI_BLOCK_IO_PROTOCOL    mBootRamDiskBlockIo;
+STATIC CHAR16                   mBootRamDiskStatus[64];
+
+STATIC
+VOID
+SetBootRamDiskStatus (
+  IN CONST CHAR16  *Text
+  )
+{
+  StrCpyS (mBootRamDiskStatus, ARRAY_SIZE (mBootRamDiskStatus), Text);
+}
+
+CONST CHAR16 *
+UniXNUGetBootRamDiskStatus (
+  VOID
+  )
+{
+  return mBootRamDiskStatus;
+}
+
+STATIC
+UINT64
+ReadFdtCells (
+  IN CONST VOID  *Data,
+  IN UINT32      Cells
+  )
+{
+  if (Cells == 2) {
+    return Fdt64ToCpu (ReadUnaligned64 (Data));
+  }
+
+  return Fdt32ToCpu (ReadUnaligned32 (Data));
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+BootRamDiskReset (
+  IN EFI_BLOCK_IO_PROTOCOL  *This,
+  IN BOOLEAN                ExtendedVerification
+  )
+{
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+BootRamDiskRead (
+  IN  EFI_BLOCK_IO_PROTOCOL  *This,
+  IN  UINT32                 MediaId,
+  IN  EFI_LBA                Lba,
+  IN  UINTN                  BufferSize,
+  OUT VOID                   *Buffer
+  )
+{
+  if ((Buffer == NULL) || (BufferSize == 0) || ((BufferSize % BOOT_RAMDISK_BLOCK_SIZE) != 0)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  if (MediaId != mBootRamDiskMedia.MediaId) {
+    return EFI_MEDIA_CHANGED;
+  }
+
+  if ((Lba > mBootRamDiskMedia.LastBlock) ||
+      (((UINT64)(BufferSize / BOOT_RAMDISK_BLOCK_SIZE)) > (mBootRamDiskMedia.LastBlock + 1 - Lba))) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  CopyMem (Buffer, mBootRamDiskBase + Lba * BOOT_RAMDISK_BLOCK_SIZE, BufferSize);
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+BootRamDiskWrite (
+  IN EFI_BLOCK_IO_PROTOCOL  *This,
+  IN UINT32                 MediaId,
+  IN EFI_LBA                Lba,
+  IN UINTN                  BufferSize,
+  IN VOID                   *Buffer
+  )
+{
+  return EFI_WRITE_PROTECTED;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+BootRamDiskFlush (
+  IN EFI_BLOCK_IO_PROTOCOL  *This
+  )
+{
+  return EFI_SUCCESS;
+}
+
+/**
+  Check whether Image starts with an Android boot header and describe where the
+  ramdisk lives. The kernel must be the AArch64 PE image the bootloader was
+  given, which keeps this from matching arbitrary memory that happens to start
+  with the magic.
+**/
+STATIC
+BOOLEAN
+BootImageLayout (
+  IN  CONST UINT8  *Image,
+  IN  UINT64       Limit,
+  OUT UINT64       *RamDiskOffset,
+  OUT UINT64       *RamDiskSize
+  )
+{
+  UINT32       KernelSize;
+  UINT32       RamDiskBytes;
+  UINT32       PageSize;
+  UINT32       HeaderVersion;
+  UINT32       PeOffset;
+  UINT64       KernelOffset;
+  UINT64       Offset;
+  CONST UINT8  *Kernel;
+
+  if (Limit < 4096) {
+    return FALSE;
+  }
+
+  if (CompareMem (Image, "ANDROID!", 8) != 0) {
+    return FALSE;
+  }
+
+  KernelSize    = ReadUnaligned32 (&Image[8]);
+  RamDiskBytes  = ReadUnaligned32 (&Image[16]);
+  PageSize      = ReadUnaligned32 (&Image[36]);
+  HeaderVersion = ReadUnaligned32 (&Image[40]);
+  if ((PageSize != 4096) || (KernelSize < 0x40) || (RamDiskBytes < BOOT_RAMDISK_BLOCK_SIZE)) {
+    return FALSE;
+  }
+
+  KernelOffset = (HeaderVersion >= 3) ? 4096 : PageSize;
+  if ((KernelOffset > Limit) || ((UINT64)KernelSize > (Limit - KernelOffset))) {
+    return FALSE;
+  }
+
+  Offset = KernelOffset + ALIGN_VALUE ((UINT64)KernelSize, 4096);
+  if ((Offset > Limit) || ((UINT64)RamDiskBytes > (Limit - Offset))) {
+    return FALSE;
+  }
+
+  Kernel = Image + KernelOffset;
+  if ((Kernel[0] != 'M') || (Kernel[1] != 'Z')) {
+    return FALSE;
+  }
+
+  PeOffset = ReadUnaligned32 (&Kernel[0x3C]);
+  if ((PeOffset > KernelSize - 6) || (ReadUnaligned32 (&Kernel[PeOffset]) != 0x00004550) ||
+      (ReadUnaligned16 (&Kernel[PeOffset + 4]) != 0xAA64)) {
+    return FALSE;
+  }
+
+  *RamDiskOffset = Offset;
+  *RamDiskSize   = RamDiskBytes;
+  return TRUE;
+}
+
+/**
+  The bootloader keeps the whole astboot boot image in memory after it hands
+  the kernel field to LoadImage, and its device tree never mentions the ramdisk.
+  Find that buffer and use the ramdisk section inside it.
+**/
+STATIC
+BOOLEAN
+FindBootImageRamDisk (
+  OUT UINT64  *Start,
+  OUT UINT64  *End
+  )
+{
+  EFI_STATUS             Status;
+  EFI_MEMORY_DESCRIPTOR  *Map;
+  UINTN                  MapSize;
+  UINTN                  MapKey;
+  UINTN                  DescSize;
+  UINT32                 DescVersion;
+  UINTN                  Index;
+  UINTN                  Count;
+  EFI_MEMORY_DESCRIPTOR  *Desc;
+  UINT64                 Limit;
+  UINT64                 Offset;
+  UINT64                 Length;
+  UINT64                 Base;
+  UINT64                 Scanned;
+  UINTN                  Candidates;
+  UINTN                  Attempts;
+
+  Map      = NULL;
+  MapSize  = 0;
+  DescSize = sizeof (EFI_MEMORY_DESCRIPTOR);
+  for (Attempts = 0; Attempts < 4; Attempts++) {
+    Status = gBS->GetMemoryMap (&MapSize, Map, &MapKey, &DescSize, &DescVersion);
+    if (Status != EFI_BUFFER_TOO_SMALL) {
+      break;
+    }
+
+    if (Map != NULL) {
+      FreePool (Map);
+      Map = NULL;
+    }
+
+    MapSize += 16 * DescSize;
+    Map      = AllocatePool (MapSize);
+    if (Map == NULL) {
+      return FALSE;
+    }
+  }
+
+  if (EFI_ERROR (Status)) {
+    if (Map != NULL) {
+      FreePool (Map);
+    }
+
+    return FALSE;
+  }
+
+  if ((DescSize < sizeof (EFI_MEMORY_DESCRIPTOR)) || ((MapSize % DescSize) != 0)) {
+    FreePool (Map);
+    return FALSE;
+  }
+
+  Count      = MapSize / DescSize;
+  Scanned    = 0;
+  Candidates = 0;
+  for (Index = 0; Index < Count; Index++) {
+    Desc = (EFI_MEMORY_DESCRIPTOR *)((UINT8 *)Map + Index * DescSize);
+    if (((Desc->Type != EfiLoaderData) && (Desc->Type != EfiBootServicesData)) ||
+        ((Desc->Attribute & EFI_MEMORY_WB) == 0) ||
+        ((Desc->Attribute & (EFI_MEMORY_RP | EFI_MEMORY_RUNTIME)) != 0) ||
+        (Desc->PhysicalStart == 0) ||
+        ((Desc->PhysicalStart & (EFI_PAGE_SIZE - 1)) != 0) ||
+        (Desc->NumberOfPages > (MAX_UINT64 >> EFI_PAGE_SHIFT))) {
+      continue;
+    }
+
+    Base  = Desc->PhysicalStart;
+    Limit = LShiftU64 (Desc->NumberOfPages, EFI_PAGE_SHIFT);
+    if ((Limit < BOOT_SCAN_MIN_IMAGE_SIZE) || (Limit > MAX_UINT64 - Base)) {
+      continue;
+    }
+
+    if (Candidates >= BOOT_SCAN_MAX_CANDIDATES) {
+      break;
+    }
+
+    if (Limit > BOOT_SCAN_MAX_BYTES - Scanned) {
+      continue;
+    }
+
+    Candidates++;
+    Scanned += Limit;
+    // Keep the existing descriptor-base search; do not probe arbitrary pages.
+    // Record the address before dereferencing it. WB/type checks are filters,
+    // not a guarantee that broken firmware mappings cannot fault.
+    UniXNULog ("S6: candidate %u base 0x%lx bytes 0x%lx type %u",
+      (UINT32)Candidates, Base, Limit, (UINT32)Desc->Type);
+    UniXNULogFlush ();
+    if (BootImageLayout ((CONST UINT8 *)(UINTN)Base, Limit, &Offset, &Length)) {
+      // Save everything before releasing Map: Desc points inside that pool.
+      *Start = Base + Offset;
+      *End   = *Start + Length;
+      FreePool (Map);
+      UniXNULog ("S6: boot image layout matched");
+      UniXNULogFlush ();
+      return TRUE;
+    }
+  }
+
+  UniXNULog ("S6: no match, %u candidates, 0x%lx bytes admitted",
+    (UINT32)Candidates, Scanned);
+  UniXNULogFlush ();
+  FreePool (Map);
+  return FALSE;
+}
+
+EFI_STATUS
+UniXNUInstallBootRamDisk (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  VOID        *Fdt;
+  INT32       Chosen;
+  INT32       StartLength;
+  INT32       EndLength;
+  CONST VOID  *StartProperty;
+  CONST VOID  *EndProperty;
+  UINT64      Start;
+  UINT64      End;
+  UINT64      LastBlock;
+  EFI_HANDLE  Handle;
+  CONST CHAR8 *Source;
+
+  if (mBootRamDiskBlockIo.Media != NULL) {
+    return EFI_ALREADY_STARTED;
+  }
+
+  Start  = 0;
+  End    = 0;
+  Source = "firmware FDT";
+
+  UniXNULog ("S6: checking firmware FDT");
+  UniXNULogFlush ();
+  Fdt    = NULL;
+  Status = EfiGetSystemConfigurationTable (&gFdtTableGuid, &Fdt);
+  if (EFI_ERROR (Status) || (Fdt == NULL) || (FdtCheckHeader (Fdt) != 0)) {
+    UniXNULog ("boot ramdisk: no valid firmware FDT: %r", Status);
+  } else {
+    Chosen = FdtPathOffset (Fdt, "/chosen");
+    if (Chosen < 0) {
+      UniXNULog ("boot ramdisk: FDT has no /chosen");
+    } else {
+      StartProperty = FdtGetProp (Fdt, Chosen, "linux,initrd-start", &StartLength);
+      EndProperty   = FdtGetProp (Fdt, Chosen, "linux,initrd-end", &EndLength);
+      if ((StartProperty == NULL) || (EndProperty == NULL) ||
+          ((StartLength != 4) && (StartLength != 8)) ||
+          ((EndLength != 4) && (EndLength != 8))) {
+        UniXNULog ("boot ramdisk: /chosen has no valid initrd range");
+      } else {
+        Start = ReadFdtCells (StartProperty, StartLength / 4);
+        End   = ReadFdtCells (EndProperty, EndLength / 4);
+        if ((Start == 0) || (End <= Start) || ((End - Start) < BOOT_RAMDISK_BLOCK_SIZE) ||
+            (End > (MAX_UINT64 - (BOOT_RAMDISK_BLOCK_SIZE - 1)))) {
+          UniXNULog ("boot ramdisk: invalid initrd range 0x%lx-0x%lx", Start, End);
+          Start = 0;
+          End   = 0;
+        }
+      }
+    }
+  }
+
+  if (Start == 0) {
+    UniXNULog ("S6: starting bounded boot image search");
+    UniXNULogFlush ();
+    if (!FindBootImageRamDisk (&Start, &End)) {
+      UniXNULog ("boot ramdisk: no /chosen initrd and no boot image buffer");
+      SetBootRamDiskStatus (L"ramdisk: not found in FDT or memory");
+      return EFI_NOT_FOUND;
+    }
+
+    Source = "boot.img buffer";
+    UniXNULog ("boot ramdisk: found boot image ramdisk at 0x%lx-0x%lx", Start, End);
+    UniXNULogFlush ();
+  }
+
+  if ((End <= Start) || ((End - Start) < BOOT_RAMDISK_BLOCK_SIZE) ||
+      (End > (MAX_UINT64 - (BOOT_RAMDISK_BLOCK_SIZE - 1)))) {
+    UniXNULog ("boot ramdisk: unusable range 0x%lx-0x%lx", Start, End);
+    SetBootRamDiskStatus (L"ramdisk: unusable range");
+    return EFI_INVALID_PARAMETER;
+  }
+
+  End = ALIGN_VALUE (End, BOOT_RAMDISK_BLOCK_SIZE);
+  LastBlock = (End - Start) / BOOT_RAMDISK_BLOCK_SIZE - 1;
+
+  mBootRamDiskBase                     = (UINT8 *)(UINTN)Start;
+  mBootRamDiskMedia.MediaId            = 1;
+  mBootRamDiskMedia.RemovableMedia     = FALSE;
+  mBootRamDiskMedia.MediaPresent       = TRUE;
+  mBootRamDiskMedia.LogicalPartition   = FALSE;
+  mBootRamDiskMedia.ReadOnly           = TRUE;
+  mBootRamDiskMedia.WriteCaching       = FALSE;
+  mBootRamDiskMedia.BlockSize          = BOOT_RAMDISK_BLOCK_SIZE;
+  mBootRamDiskMedia.IoAlign            = 1;
+  mBootRamDiskMedia.LastBlock          = LastBlock;
+
+  mBootRamDiskBlockIo.Revision   = EFI_BLOCK_IO_PROTOCOL_REVISION;
+  mBootRamDiskBlockIo.Media      = &mBootRamDiskMedia;
+  mBootRamDiskBlockIo.Reset      = BootRamDiskReset;
+  mBootRamDiskBlockIo.ReadBlocks = BootRamDiskRead;
+  mBootRamDiskBlockIo.WriteBlocks = BootRamDiskWrite;
+  mBootRamDiskBlockIo.FlushBlocks = BootRamDiskFlush;
+
+  UniXNULog ("S6: installing ramdisk protocols");
+  UniXNULogFlush ();
+  Handle = NULL;
+  Status = gBS->InstallMultipleProtocolInterfaces (
+                  &Handle,
+                  &gEfiDevicePathProtocolGuid,
+                  &mBootRamDiskDevicePath,
+                  &gEfiBlockIoProtocolGuid,
+                  &mBootRamDiskBlockIo,
+                  NULL
+                  );
+  if (EFI_ERROR (Status)) {
+    mBootRamDiskBlockIo.Media = NULL;
+    UniXNULog ("boot ramdisk: install failed: %r", Status);
+    SetBootRamDiskStatus (L"ramdisk: BlockIo install failed");
+    return Status;
+  }
+
+  UniXNULog (
+    "boot ramdisk: initrd 0x%lx-0x%lx, %u bytes, first words %08x %08x",
+    Start,
+    End,
+    (UINT32)(End - Start),
+    ReadUnaligned32 (mBootRamDiskBase),
+    ReadUnaligned32 (mBootRamDiskBase + 4)
+    );
+  UnicodeSPrint (
+    mBootRamDiskStatus,
+    sizeof (mBootRamDiskStatus),
+    L"ramdisk: %u MiB from %a, first %04x",
+    (UINT32)((End - Start) >> 20),
+    Source,
+    ReadUnaligned32 (mBootRamDiskBase) & 0xFFFF
+    );
+
+  UniXNULog ("S6: connecting ramdisk controller");
+  UniXNULogFlush ();
+  gBS->ConnectController (Handle, NULL, NULL, TRUE);
+  UniXNULog ("S6: ramdisk controller connect returned");
+  UniXNULogFlush ();
+  return EFI_SUCCESS;
+}
