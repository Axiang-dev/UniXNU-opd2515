+CONST CHAR16 *
+UniXNUGetBootRamDiskStatus (
+  VOID
+  );
+
+/**
+  Reserve the last 4 MiB of the userdata partition as a persistent text log and
+  write the lines buffered so far. Only that window is written; a board whose
+  firmware exposes no writable userdata keeps logging to the serial port alone.
+**/
+EFI_STATUS
+UniXNUInstallBootLog (
