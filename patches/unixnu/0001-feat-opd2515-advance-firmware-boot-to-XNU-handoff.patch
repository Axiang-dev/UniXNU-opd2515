@@ -0,0 +1,15 @@
+# OS patch series for xnu-8796 (iOS 16.5 / Darwin 22.5.0). One patch path per
+# line in application order; `#` starts a comment. Relative paths resolve from
+# this directory. Prefixes `arch:`, `soc:`, `device:` select their profile roots
+# and `component:<ID>/path` selects a component file.
+#
+# Intentionally empty. The whole resolved order is rebased onto xnu-8796 and
+# carried by the device repository in patches/xnu/series, which board.toml
+# selects on its own. It holds the ARM64, SoC and OS patches in their original
+# order plus the two prelink patches XnuPrelink ships only for xnu-10063, and is
+# verified to apply strictly in sequence onto xnu-8796.101.5.
+#
+# Move the entries back here, and into arch: and soc:, once those shared series
+# are rebased. Until then this file stays empty so `unixnu status` never
+# resolves a version-10063 path; doing so aborts with "patch missing" and blocks
+# every later step.
diff --git a/profiles/os/ios-16.5-20F66/profile.toml b/profiles/os/ios-16.5-20F66/profile.toml
new file mode 100644
index 0000000..6d48908
--- /dev/null
+++ b/profiles/os/ios-16.5-20F66/profile.toml
@@ -0,0 +1,244 @@
+# iOS 16.5 OS profile for UniXNU.
+#
+# Target: iOS 16.5 (build 20F66), Darwin 22.5.0, XNU 8796.
+# Identity: iPhone X (iPhone10,3 / D22AP).
+#
+# This profile lives in UniXNU/profiles/os/ios-16.5-20F66/. The 64-patch
+# resolved series and board-specific prelink adapter remain in the device
+# repository because they are tied to the selected kernelcache and board.
+#
+# XNU 8796 is the iOS 16 kernel. This port pins the public
+# xnu-8796.121.2 source drop. The running iPhone10,3 kernelcache reports
+# xnu-8796.122.4; that internal build number is recorded as evidence and is not
+# replaced with the public source revision.
+#
+# The IPSW-derived values below were read out of
+# iPhone10,3,iPhone10,6_16.5_20F66_Restore.ipsw with
+# scripts/extract-ipsw-pins.py, which reproduces every one of them. The kexts
+# carry CFBundleVersion 22.5.0, which independently confirms the Darwin version.
+
+["os"]
+"name" = "ios-16.5-20F66"
+"darwin" = "22.5.0"
+"xnu_version" = "8796.121.2"
+"xnu_revision" = "c54f35ca767986246321eb901baf8f5ff7923f6a"
+"driverkit_tag" = "xnu-8796.101.5"
+"trustcache_tag" = "xnu-8796.101.5"
+"abi" = ["IOGPUFamily", "IOHIDFamily-2031.120.4", "IOMobileGraphicsFamily"]
+
+
+["ipsw"]
+# The restore image is not redistributable. Point the build at a local copy with
+# --ipsw or UNIXNU_IPSW when a full download is not desired. UniXNU reads only
+# the manifest members listed below from the remote IPSW.
+"url" = "https://updates.cdn-apple.com/2023SpringFCS/fullrestores/032-85130/6AB0D10A-8AF9-4F6C-8CF5-A1B315CABE88/iPhone10,3,iPhone10,6_16.5_20F66_Restore.ipsw"
+"product" = "iPhone10,3"
